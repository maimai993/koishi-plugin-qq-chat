{
  "name": "QQ 机器人手机端",
  "short_name": "QQ 机器人",
  "description": "连接 Koishi 的 qq-chat 插件：在手机上收发 QQ 官方机器人的消息",
  "start_url": "/qq-chat/m",
  "scope": "/qq-chat/m",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f6f7",
  "theme_color": "#0099ff",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}